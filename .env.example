# ─── WhatsApp Business Cloud API ────────────────────────────────────────────
# Panel: https://developers.facebook.com/apps  ->  WhatsApp  ->  API Setup

# Token de acceso. Usa un System User token permanente en producción;
# el token temporal de prueba caduca en 24 h.
WHATSAPP_ACCESS_TOKEN=

# ID del número de teléfono emisor (Phone number ID, NO el número en sí)
WHATSAPP_PHONE_NUMBER_ID=

# ID de la cuenta de WhatsApp Business (WABA ID). Necesario para
# plantillas y catálogo.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# App Secret de la app de Meta. Se usa para validar la firma
# X-Hub-Signature-256 de los webhooks. Sin esto, los webhooks se rechazan
# salvo que pongas ALLOW_UNSIGNED_WEBHOOKS=true.
META_APP_SECRET=

# Token que tú inventas y pegas igual en el panel de webhooks de Meta.
WEBHOOK_VERIFY_TOKEN=cambia-esto-por-algo-aleatorio

# Versión del Graph API. Súbela cuando Meta publique una nueva.
GRAPH_API_VERSION=v23.0

# ─── Servidor ───────────────────────────────────────────────────────────────
PORT=3001
DATABASE_PATH=./data/app.db
MEDIA_DIR=./data/media

# Clave para acceder al panel (cabecera x-api-key o ?key=). Déjala vacía
# para desactivar la autenticación SOLO en desarrollo local.
APP_API_KEY=

# Pon true únicamente para pruebas locales sin firma de Meta.
ALLOW_UNSIGNED_WEBHOOKS=false
