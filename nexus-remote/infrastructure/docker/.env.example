# ---------------------------------------------------------------------------
# NEXUS REMOTE — variables de entorno de la infraestructura
#
# Copie este archivo a `.env` en la misma carpeta y rellene los valores.
# El archivo `.env` NO debe subirse al repositorio: contiene secretos.
#
#   cp .env.example .env
#   chmod 600 .env
# ---------------------------------------------------------------------------

# --- Dominio y certificados -------------------------------------------------

# Dominio publico que apunta al servidor. Hace falta un registro A (y AAAA si
# tiene IPv6) apuntando a la IP publica de la maquina.
NEXUS_DOMAIN=nexus.midominio.com

# Correo para los avisos de caducidad de Let's Encrypt.
NEXUS_ACME_EMAIL=usted@midominio.com

# --- Servidor de senalizacion ----------------------------------------------

# Direccion de escucha DENTRO del contenedor. El proxy inverso es quien se
# expone a Internet; este proceso no debe publicarse directamente.
NEXUS_BIND_ADDRESS=0.0.0.0:8443

# URL publica del canal de senalizacion, la que se guarda en el host y viaja en
# el QR de emparejamiento. Debe ser wss://, nunca ws://.
NEXUS_PUBLIC_URL=wss://nexus.midominio.com/signaling

# Nivel de registro: error, warn, info, debug, trace.
NEXUS_LOG=info

# --- TURN (Coturn) ----------------------------------------------------------
#
# Secreto compartido entre el servidor de senalizacion y Coturn. De el se
# derivan las credenciales temporales de cada sesion.
#
# GENERELO ASI, no lo invente:
#   openssl rand -base64 48
#
# Minimo 32 caracteres. El servidor se niega a arrancar con uno mas corto.
NEXUS_TURN_SHARED_SECRET=CAMBIE_ESTE_VALOR_POR_UNO_GENERADO_CON_OPENSSL

# Validez de las credenciales TURN emitidas, en segundos. 43200 = 12 horas.
NEXUS_CREDENTIAL_TTL_SECS=43200

# URL de los servidores TURN que se entregan al cliente, separadas por comas.
# `turns:` es TURN sobre TLS en el puerto 5349: es el que atraviesa las redes
# corporativas que solo dejan salir por el 443/5349.
NEXUS_TURN_URLS=turn:nexus.midominio.com:3478?transport=udp,turns:nexus.midominio.com:5349?transport=tcp

# URL de los servidores STUN, separadas por comas. Se usa el propio Coturn, que
# tambien hace de STUN, para no depender de servidores publicos de terceros.
NEXUS_STUN_URLS=stun:nexus.midominio.com:3478

# IP publica de la maquina. Coturn la necesita para anunciar los candidatos
# correctos cuando esta detras de NAT (habitual en nubes como AWS o GCP).
# Dejela vacia si la maquina tiene la IP publica directamente en su interfaz.
NEXUS_EXTERNAL_IP=

# Rango de puertos UDP que Coturn usa para retransmitir. Debe estar abierto en
# el cortafuegos. Un rango mas estrecho limita las sesiones simultaneas.
NEXUS_TURN_MIN_PORT=49160
NEXUS_TURN_MAX_PORT=49200
